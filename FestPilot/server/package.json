{
  "name": "@festpilot/server",
  "version": "0.0.0",
  "private": true,
  "description": "FestPilot backend — Cloudflare Worker: lineup ingestion (cron) + read API on D1.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:create": "wrangler d1 create festpilot",
    "db:migrate:local": "wrangler d1 migrations apply festpilot --local",
    "db:migrate": "wrangler d1 migrations apply festpilot --remote"
  },
  "dependencies": {
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@types/node": "^26.0.0",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}
