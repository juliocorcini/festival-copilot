{
  "name": "@festpilot/web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "FestPilot PWA: Amber-Glass app — onboarding, favorites, timetable, lock-in, map, squads with a shared timetable, coarse live presence, and squad meeting points.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
