# FestPilot web (Vite) — public config TEMPLATE.
# Copy to `.env` (same folder) and fill. `.env` is gitignored. These are NOT secrets (client-side),
# so the Firebase web config can even be shared in chat. All FREE tier (DEC-037).

# Where the app reads the API (the deployed Worker URL; for local dev use http://127.0.0.1:8787).
VITE_API_URL=

# --- Firebase web config (Firebase console -> Project settings -> "Your apps" -> Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Web Push (FCM) ---
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates -> generate a key pair.
VITE_FCM_VAPID_KEY=
